{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishTagAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-southeast-2:<account-id>:ecoguard-tag-alerts"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-2:<account-id>:log-group:/aws/lambda/ecoguard-notify:*"
    }
  ]
}
