{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTheAlertTopicsSubscribers",
      "Effect": "Allow",
      "Action": ["sns:Subscribe", "sns:ListSubscriptionsByTopic"],
      "Resource": "arn:aws:sns:us-east-1:<account-id>:ecoguard-tag-alerts"
    },
    {
      "Sid": "ReadAndChangeOneSubscription",
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Unsubscribe"
      ],
      "Resource": "arn:aws:sns:us-east-1:<account-id>:ecoguard-tag-alerts:*"
    }
  ]
}
