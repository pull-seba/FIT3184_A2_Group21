{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheSubscriptionsFunction",
      "Effect": "Allow",
      "Principal": { "Federated": "accounts.google.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "accounts.google.com:sub": "<fn-subscriptions unique ID>",
          "accounts.google.com:oaud": "arn:aws:iam::<account-id>:role/ecoguard-subscriptions"
        }
      }
    }
  ]
}
