{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm test)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(firebase *)",
      "Bash(aws *)",
      "Bash(scripts/seed_data.py *)",
      "Bash(python scripts/seed_data.py *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/service-account*.json)",
      "Read(**/*credentials*.json)"
    ]
  }
}
